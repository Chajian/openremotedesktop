ODR_DOMAIN=remote.example.com
# When reusing one Server across multiple HTTPS hostnames, keep ODR_PUBLIC_BASE_URL
# as the original OAuth issuer, then list additional trusted HTTPS origins here.
# ODR_ADDITIONAL_PUBLIC_BASE_URLS=https://openremotedesktop.com
DEBUG_PAYLOAD_LOGGING=false
# Keep off until the matching npm Agent version is publicly approved and deployed.
ODR_AGENT_INSTALL_ENABLED=false
# Minimal device-deletion audit event retention (1..3650 days; default 30).
# ODR_DEVICE_DELETION_AUDIT_RETENTION_DAYS=30

# Optional GitHub OAuth App login (callback: https://YOUR_DOMAIN/auth/github/callback)
# ODR_GITHUB_CLIENT_ID=
# ODR_GITHUB_CLIENT_SECRET=
